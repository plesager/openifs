#! /usr/bin/env bash

# Install a Python version in .bootstrap/venv that contains all necessary 
# modules (click pyyaml) and pull all data to .bootstrap/cache.

set -e

# Get path to the repo root.
BIN_PATH=$(dirname -- "${BASH_SOURCE[0]}")
ROOT_PATH=$(realpath "${BIN_PATH}/../")
BOOTSTRAP_PATH=${ROOT_PATH}/.bootstrap

if ! python3 -c "import sys; sys.exit(sys.version_info < (3, 10))"
then
  echo "At least Python 3.10 is required!" >&2
  exit 1
fi

python3 -m venv ${BOOTSTRAP_PATH}/venv || true

PYTHON_PATH=${BOOTSTRAP_PATH}/venv/bin/python3

if [ ! -f "${PYTHON_PATH}" ]
then
  echo "Setup of virtual environment failed."
  exit 1
fi

if ! "${PYTHON_PATH}" -c "import sys; sys.exit(sys.version_info < (3, 10))"
then
  echo "The bootstrap virtual environment requires at least Python 3.10." >&2
  exit 1
fi

"${PYTHON_PATH}" -m pip install "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70"
"${PYTHON_PATH}" -m pip install --upgrade "certifi>=2026.10.19"
"${PYTHON_PATH}" -m pip install click pyyaml

${PYTHON_PATH} ${BIN_PATH}/storage.py cache --force \
  ${ROOT_PATH}/storage.yaml ${BOOTSTRAP_PATH}/cache
